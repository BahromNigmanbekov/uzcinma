{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "{server/**,shared/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/app-client.:extension",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/manage/:path*",
      "destination": "/api/manage?route=:path*"
    },
    {
      "source": "/",
      "destination": "/api/seo?view=home"
    },
    {
      "source": "/title/:id",
      "destination": "/api/seo?view=title&id=:id"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?view=sitemap"
    },
    {
      "source": "/sitemaps/pages.xml",
      "destination": "/api/seo?view=pages"
    },
    {
      "source": "/sitemaps/titles-:page.xml",
      "destination": "/api/seo?view=titles&page=:page"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "uzcinma.vercel.app"
        }
      ],
      "destination": "https://uzcinma.uz/",
      "permanent": true
    },
    {
      "source": "/title/:id",
      "has": [
        {
          "type": "host",
          "value": "uzcinma.vercel.app"
        }
      ],
      "destination": "https://uzcinma.uz/title/:id",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "uzcinma.vercel.app"
        }
      ],
      "destination": "https://uzcinma.uz/robots.txt",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "uzcinma.vercel.app"
        }
      ],
      "destination": "https://uzcinma.uz/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/sitemaps/:path*",
      "has": [
        {
          "type": "host",
          "value": "uzcinma.vercel.app"
        }
      ],
      "destination": "https://uzcinma.uz/sitemaps/:path*",
      "permanent": true
    }
  ]
}
