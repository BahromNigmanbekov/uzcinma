# These are server secrets. Never prefix them with VITE_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BOT_TOKEN=
# Telegram application credentials from my.telegram.org/apps, server only.
API_ID=
API_HASH=
ADMIN_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_API_SECRET=
# Cloud admin: JSON {salt,hash} from .private/admin/auth.json; scrypt, server only.
ADMIN_PASSWORD_HASH=
# Public HTTPS origin after deployment (no trailing slash).
APP_ORIGIN=
# Preview only: showcase catalog and the clearly labeled HLS test film.
DEMO_MODE=0

# Leave empty for uploaded bot videos. Use database only after Turso migration; demo for design showcase.
CATALOG_MODE=

# Optional separate uploader deployment (see ADMIN.md).
ADMIN_ORIGIN=
ADMIN_PASSWORD=
# Public backend origin only, never a token.
VITE_API_BASE=

# Optional TMDB credentials. Prefer API Read Access Token. Server only.
# The admin panel can also save a credential encrypted in the database.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=
