{
  "name": "uzcinma-vercel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "bot:connect": "node scripts/connect-bot.mjs",
    "test:browser": "node tests/bot-videos.browser.mjs",
    "test:production": "node tests/bot-videos.browser.mjs",
    "bot:sync": "python scripts/sync-bot-videos.py",
    "test:controls": "node tests/player-controls.browser.mjs",
    "test:banner": "node tests/banner.browser.mjs",
    "admin:server": "node scripts/admin-server.mjs",
    "test:admin": "node tests/admin.browser.mjs",
    "test:series": "npm run build && node tests/series.browser.mjs",
    "test:credits": "npm run build && node tests/credits.browser.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "hls.js": "^1.6.0",
    "swiper": "^12.0.0",
    "teleproto": "1.232.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "^6.4.0"
  }
}
